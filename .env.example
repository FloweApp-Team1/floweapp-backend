# ============================================================
# FloweApp - local Docker Compose environment (template)
# Copy this file to .env and fill in real values.
# .env is gitignored; .env.example is the committed reference.
# ============================================================

# ---------- General ----------
ASPNETCORE_ENVIRONMENT=Development

# ---------- Identity Service ----------
IDENTITY_HTTP_PORT=5192
IDENTITY_HTTPS_PORT=7056
DOCKER_REGISTRY=

# SQL Server connection (composed into ConnectionStrings__DefaultConnection in docker-compose.yml)
SQL_SERVER=localhost
IDENTITY_DB=FlowersAppIdentityDb
SQL_USER=sa
# Must match the SA password if a SQL Server container is added
SQL_PASSWORD=Change_Me!12345

# ---------- RabbitMQ ----------
RABBITMQ_USER=floweapp
RABBITMQ_PASSWORD=Change_Me_RabbitMQ_2026!
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---------- Redis ----------
REDIS_PORT=6379
