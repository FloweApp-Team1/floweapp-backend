# ============================================================
# FloweApp - local Docker Compose environment (template)
# Copy this file to .env and fill in real values.
# .env is gitignored; .env.example is the committed reference.
# ============================================================

# ---------- General ----------
ASPNETCORE_ENVIRONMENT=Development

# ---------- Identity Service ----------
IDENTITY_HTTP_PORT=5192
IDENTITY_HTTPS_PORT=7056
IDENTITY_IMAGE_TAG=latest
DOCKER_REGISTRY=

# ---------- SQL Server ----------
# One shared database for the whole FloweApp application; each microservice
# uses its own schema inside it (IdentityService -> "Auth").
# "sqlserver" inside the Docker network, "localhost" when running on the host.
SQL_SERVER=sqlserver
DATABASE_NAME=FlowersAppDb
SQL_USER=sa
# Single source of truth for the SA password (container AND app connection string).
# 8+ chars, 3 of 4: upper/lower/digit/symbol. Avoid $, `, " characters.
MSSQL_SA_PASSWORD=Change_Me!12345
MSSQL_PORT=1433
MSSQL_PID=Developer

# ---------- RabbitMQ ----------
RABBITMQ_USER=floweapp
RABBITMQ_PASSWORD=Change_Me_RabbitMQ_2026!
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---------- Redis ----------
REDIS_PORT=6379
# Used by the app (StackExchange.Redis). "redis" inside the Docker network
# (docker-compose overrides this), "localhost" when running on the host.
Redis__ConnectionString=localhost:6379

# ---------- Firebase ----------
# HOST path to the Firebase service account JSON, used when running locally
# (Visual Studio / `dotnet run`). Use forward slashes.
# In Docker this value is IGNORED: docker-compose overrides it with the container
# mount path /run/secrets/firebase-service-account.json (mounted read-only from
# ./secrets/firebase-service-account.json).
Firebase__CredentialsPath=C:/path/to/floweapp-backend/secrets/firebase-service-account.json

# ---------- JWT ----------
# Bind to the "Jwt" config section (Jwt__X -> Jwt:X). SecretKey must be >= 32 chars;
# generate a long random value and keep it out of source control.
Jwt__SecretKey=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__Issuer=FlowersApp.IdentityService
Jwt__Audience=FlowersApp.Clients
Jwt__AccessTokenExpiryMinutes=15

# ---------- Email (SMTP) ----------
# Bind to the "Email" config section (Email__X -> Email:X).
Email__SmtpHost=smtp.example.com
Email__SmtpPort=587
Email__SenderEmail=no-reply@flowersapp.com
Email__SenderName=Flowers App
Email__Username=smtp-username
Email__Password=smtp-password
Email__EnableSsl=true
