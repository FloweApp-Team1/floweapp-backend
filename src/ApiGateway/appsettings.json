{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "AuthPolicy",
        "Transforms": [
          {
            "PathRemovePrefix": "/api/identity"
          }
        ],
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        }
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "RateLimiterPolicy": "DefaultPolicy",
        "Transforms": [
          {
            "PathRemovePrefix": "/api/catalog"
          }
        ],
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "destination1": {
            "Address": "http://placeholder-identity"
          }
        }
      },
      "catalog-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "destination1": {
            "Address": "http://placeholder-catalog"
          }
        }
      }
    }
  },
  "RateLimiting": {
    "AuthPolicy": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "DefaultPolicy": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    }
  }
}
