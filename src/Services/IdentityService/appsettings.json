{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "Issuer": "FlowersApp.IdentityService",
    "Audience": "FlowersApp.Clients",
    "AccessTokenExpiryMinutes": 15
  },
  "Email": {
    "SmtpHost": "smtp.example.com",
    "SmtpPort": 587,
    "SenderEmail": "no-reply@flowersapp.com",
    "SenderName": "Flowers App",
    "Username": "smtp-username",
    "Password": "smtp-password",
    "EnableSsl": true
  }
  // NOTE: Connection strings, Firebase paths, and other settings are NOT configured
  // here. They are read exclusively from environment variables (.env locally,
  // docker-compose `environment:` in containers). See Program.cs.
}
