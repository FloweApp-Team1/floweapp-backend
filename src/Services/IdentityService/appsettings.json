{
  // Runtime configuration is NOT stored here.
  //
  // Connection strings, JWT, Email, Redis, Firebase, OTP and admin-seed values are
  // read exclusively from environment variables (.env locally, docker-compose
  // `environment:` in containers) and bound in Infrastructure/DependencyInjection.cs.
  // Keeping defaults here as well would shadow a missing variable and let the app
  // start with placeholder secrets instead of failing fast.
  //
  // Only non-secret, environment-independent host settings remain below.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
