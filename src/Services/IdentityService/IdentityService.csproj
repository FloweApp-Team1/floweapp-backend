    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>64a0b1c9-abb9-4239-a8ab-56fd80ba7f41</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..</DockerfileContext>
